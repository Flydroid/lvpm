    { "dot": "emerald", "title": "Works today", "items": ["Per-project .lv-venv, one LabVIEW process each: same package, different versions, no clash (a global copy still shadows it)", "Install from VIPM/NI indexes and folders; hooks never run in a venv; headless skips them unless --hooks", "NIPM dependencies checked; lvpm launch / relink / refresh"] },

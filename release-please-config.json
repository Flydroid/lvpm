{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "include-component-in-tag": false,
  "bump-minor-pre-major": true,
  "packages": {
    ".": {
      "extra-files": [
        { "type": "toml", "path": "Cargo.toml", "jsonpath": "$.workspace.package.version" },
        { "type": "toml", "path": "Cargo.lock", "jsonpath": "$.package[?(@.name=='lvpm')].version" },
        { "type": "toml", "path": "Cargo.lock", "jsonpath": "$.package[?(@.name=='lvpm-core')].version" },
        { "type": "toml", "path": "Cargo.lock", "jsonpath": "$.package[?(@.name=='lvpm-testkit')].version" },
        { "type": "toml", "path": "Cargo.lock", "jsonpath": "$.package[?(@.name=='lvpm-tui')].version" }
      ]
    }
  }
}
